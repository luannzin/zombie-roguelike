{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "client",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "client",
        "run",
        "dev"
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "server",
      "runtimeExecutable": "server/.venv/bin/python",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "--app-dir",
        "server",
        "app.main:app",
        "--reload",
        "--port",
        "8000"
      ],
      "port": 8000
    }
  ]
}