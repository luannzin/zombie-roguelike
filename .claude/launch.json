{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "client",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["run", "--cwd", "client", "dev"],
      "port": 5173
    },
    {
      "name": "server",
      "runtimeExecutable": "server/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--port", "8000", "--app-dir", "server"],
      "port": 8000
    }
  ]
}
